{
  "crons": [
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 6 * * 1"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kunjshah.in"
        }
      ],
      "destination": "https://kunjshah.in/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kunjshah.vercel.app"
        }
      ],
      "destination": "https://kunjshah.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kunjshah.in"
        }
      ],
      "destination": "https://kunjshah.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kunjshah.vercel.app"
        }
      ],
      "destination": "https://kunjshah.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/api-catalog",
      "destination": "/.well-known/api-catalog.json"
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/.well-known/agent-skills/index.json",
      "destination": "/.well-known/agent-skills/index.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/portfolio.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/ai.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/pricing.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/services.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/.well-known/ai.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/agent-skills/index.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", <https://kunjshah.in/openapi.json>; rel=\"service-desc\"; type=\"application/openapi+json\", <https://kunjshah.in/.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", <https://kunjshah.in/llms.txt>; rel=\"alternate\"; type=\"text/markdown\", <https://kunjshah.in/llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\", <https://kunjshah.in/ai.txt>; rel=\"alternate\"; type=\"text/markdown\", <https://kunjshah.in/.well-known/ai.txt>; rel=\"alternate\"; type=\"text/markdown\", <https://kunjshah.in/pricing.md>; rel=\"pricing\", <https://kunjshah.in/services.md>; rel=\"service\", <https://kunjshah.in/rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\", <https://kunjshah.in/sitemap.xml>; rel=\"sitemap\""
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Signal",
          "value": "search=yes, ai-input=yes, ai-train=no"
        }
      ]
    }
  ]
}
