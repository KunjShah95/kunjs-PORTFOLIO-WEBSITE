# Email delivery for the contact form (resend.com/api-keys)
RESEND_API_KEY=

# Verified Resend sender. Leave blank to use Resend's onboarding@resend.dev
# sandbox, which only delivers to the address on the Resend account.
# For production set e.g. CONTACT_FROM="Portfolio <hello@kunjshah.in>"
CONTACT_FROM=

# Where form inquiries are delivered. Defaults to site.email (the address shown
# on the page). With the onboarding@resend.dev sandbox sender this MUST be the
# address on your Resend account, since the sandbox delivers nowhere else.
CONTACT_TO=

# Only for testing the form against a local mock of the Resend API.
# CONTACT_RESEND_URL=http://localhost:4599/emails

# Addresses to refuse outright, comma-separated. Use this for repeat
# offenders: their messages are dropped silently, so they get no signal
# that they were filtered.
# CONTACT_BLOCKED_EMAILS=spam@example.com,abuse@example.com

# Cloudflare Turnstile bot verification for the contact form.
# The public half (NEXT_PUBLIC_TURNSTILE_SITE_KEY) is embedded in the page;
# the secret half is used for the server-side siteverify call. Turnstile is
# only enforced when BOTH TURNSTILE_SECRET_KEY and TURNSTILE_HOSTNAMES are
# set — leave them unset and the form keeps working exactly as it does now.
# Get the key pair from the Cloudflare dashboard: Turnstile → Add widget.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_HOSTNAMES=kunjshah.in,www.kunjshah.in

# Optional: a GitHub token lifts the unauthenticated search rate limit
# (10 req/min) to 30 req/min for the open-source activity feed.
GITHUB_TOKEN=

# IndexNow (Bing/Yandex). Public key file: /7c4f9e2a1b8d4056a3f2e1d9c8b7a605.txt
# Register the key in Bing Webmaster Tools, then run: npm run indexnow
INDEXNOW_KEY=

# Vercel Cron auth for /api/cron/indexnow (weekly URL refresh ping)
CRON_SECRET=
