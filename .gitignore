videos/
# Exception: the published demo recordings under public/videos/ are part of the
# deploy, and the videos/ rule above (meant for scratch recordings) would
# otherwise drop them. DemoVideo resolves `<src>.webm` then `<src>.mp4` with a
# `<src>.webp` poster, so all three have to be tracked or the card ships broken.
!public/videos/
public/videos/*
!public/videos/*.mp4
!public/videos/*.webm
!public/videos/*.webp
!public/videos/*.jpg

# Perf audit output (scripts/perf-audit.mjs). Regenerated per machine and
# against a localhost URL, so the numbers are only meaningful locally. Run
# `node scripts/perf-audit.mjs --url <url> --out <label>` to produce one.
perf-*.json

# Screenshot scratch (scripts/shoot.mjs). Regenerated per run against a
# local server, so the images are only meaningful locally.
tmp-shots/
